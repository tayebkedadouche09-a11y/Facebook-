# DZ Smart Seller combined local deployment
# Copy this file to .env.dz-smart-seller and replace every placeholder.
# Generate each secret locally with: openssl rand -hex 32
# Do not commit the real .env.dz-smart-seller file.

# Postmill (Facebook-)
POSTMILL_URL=http://localhost:4007
REDIS_URL=redis://postmill-redis:6379
POSTMILL_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
POSTMILL_JWT_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET
POSTMILL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_SECRET

# OpenPost (Facebook-2)
OPENPOST_URL=http://localhost:8080
OPENPOST_JWT_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET
OPENPOST_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_SECRET

# Meta / Facebook Pages
# Keep [] until you create a Meta app. Then replace it with a JSON array containing
# your own client_id and client_secret. Never commit the real env file.
OPENPOST_PROVIDER_APPS=[]
